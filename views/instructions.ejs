<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Private Access</title>
  <meta name="description" content="Click to view my official links and social media content.">
  <meta property="og:title" content="My Official Profile">
  <meta property="og:type" content="website">
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1a0014, #4d002f, #ff006e);
      background-size: 180% 180%;
      animation: glow 10s ease infinite;
      color: #fff;
      text-align: center;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100vh;
    }
    @keyframes glow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    h1 { font-size: 3em; margin-bottom: 5px; letter-spacing: 2px; font-weight: 700; }
    h2 { font-size: 1.5em; margin-bottom: 30px; opacity: 0.9; }
    p  { font-size: 1.3em; margin: 10px 0; opacity: 0.95; }
    img { max-width: 90%; margin-top: 25px; border-radius: 15px; box-shadow: 0 0 20px rgba(255, 0, 112, 0.6); animation: softPulse 3s infinite ease-in-out; }
    @keyframes softPulse { 0% { transform: scale(1); opacity:.95 } 50% { transform: scale(1.03); opacity:1 } 100% { transform: scale(1); opacity:.95 } }
    .muted { opacity: .85; font-size: .95em; margin-top: 12px; }
  </style>
</head>
<body>
  <div id="instructionsCard">
    <h1>PRIVATE ACCESS</h1>
    <h2>Follow these instructions to enter</h2>
    <p>1. Tap the three dots in the upper right corner.</p>
    <p>2. Select <b>"Open in browser"</b>.</p>
    <img src="/clook/gif/gitonly.png" alt="Instructions">
    <p class="muted">If you already opened this page in your default browser, you’ll be redirected automatically.</p>
  </div>

  <script>
      function isInApp() {
        const ua = (navigator.userAgent || navigator.vendor || window.opera || '').toLowerCase();
        // Si el UA contiene cualquiera de estas palabras, estamos CERRADOS en la app
        return /tiktok|musically|instagram|fb_iab|fban|fbav/.test(ua);
      }

      (function init(){
        const ua = navigator.userAgent.toLowerCase();
        console.log("User Agent actual:", ua);

        // 1. REGLA DE ORO: Si detectamos TikTok, MATAMOS el script aquí mismo.
        if (isInApp()) {
          console.log("Detenido: Estás dentro de una App Social.");
          return; // Aquí muere el script. El usuario NO será redirigido.
        }

        // 2. REGLA DE SEGURIDAD: Si por alguna razón el UA no es TikTok pero tampoco
        // parece un navegador móvil real (Safari/Chrome), también nos quedamos quietos.
        const isMobileBrowser = /iphone|ipad|android/.test(ua) && /safari|chrome|crios|fxios/.test(ua);
        
        if (!isMobileBrowser) {
          console.log("No parece un navegador móvil estándar. Manteniendo instrucciones.");
          return;
        }

        // 3. SOLO SI YA SALIÓ: Preparamos el ID y el salto
        const m = (location.pathname || '').match(/^\/instructions\/([^\/?#]+)/i);
        const idFromPath = m ? decodeURIComponent(m[1]) : null;
        
        // Si no hay ID en el path, intentamos sacarlo de la URL limpia (dominio propio)
        const id = idFromPath || window.location.pathname.split('/').filter(p => p && p !== 'instructions')[0];
        const loadingPath = id ? `/loading/${id}` : '/loading';

        console.log("Fuera de la app detectado. Redirigiendo a:", loadingPath);
        
        // Esperamos 2 segundos completos antes de mover al usuario
        setTimeout(() => {
          window.location.href = loadingPath;
        }, 2000);
      })();
  </script>

  <noscript>
    <p style="margin-top:16px">Enable JavaScript to continue.</p>
  </noscript>
</body>
</html>
