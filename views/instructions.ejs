<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Private Access</title>
  <meta name="description" content="Click to view my official links and social media content.">
  <meta property="og:title" content="My Official Profile">
  <meta property="og:type" content="website">
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1a0014, #4d002f, #ff006e);
      background-size: 180% 180%;
      animation: glow 10s ease infinite;
      color: #fff;
      text-align: center;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100vh;
    }
    @keyframes glow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    h1 { font-size: 3em; margin-bottom: 5px; letter-spacing: 2px; font-weight: 700; }
    h2 { font-size: 1.5em; margin-bottom: 30px; opacity: 0.9; }
    p  { font-size: 1.3em; margin: 10px 0; opacity: 0.95; }
    img { max-width: 90%; margin-top: 25px; border-radius: 15px; box-shadow: 0 0 20px rgba(255, 0, 112, 0.6); animation: softPulse 3s infinite ease-in-out; }
    @keyframes softPulse { 0% { transform: scale(1); opacity:.95 } 50% { transform: scale(1.03); opacity:1 } 100% { transform: scale(1); opacity:.95 } }
    .muted { opacity: .85; font-size: .95em; margin-top: 12px; }
  </style>
</head>
<body>
  <div id="instructionsCard">
    <h1>PRIVATE ACCESS</h1>
    <h2>Follow these instructions to enter</h2>
    <p>1. Tap the three dots in the upper right corner.</p>
    <p>2. Select <b>"Open in browser"</b>.</p>
    <img src="/clook/gif/gitonly.png" alt="Instructions">
    <p class="muted">If you already opened this page in your default browser, you’ll be redirected automatically.</p>
  </div>

  <script>
    /**
     * IMPORTANTE: Estas variables las inyecta el servidor (EJS).
     * isSocialApp será TRUE si el servidor detecta TikTok/Instagram.
     * id será el ID de la modelo para construir la ruta de carga.
     */

    const isSocialApp = <%- JSON.stringify(!!isSocialApp) %>;
    const modelId     = <%- JSON.stringify(id || null) %>;


    (function init(){
      console.log("Estado de App Social:", isSocialApp);

      // REGLA DE ORO: Si el servidor detectó que estamos en TikTok/IG, 
      // bloqueamos cualquier ejecución automática.
      if (isSocialApp === true) {
        console.log("DETENIDO: Navegador interno detectado. El usuario debe salir manualmente.");
        return; 
      }

      // REGLA DE SALIDA: Si llegamos aquí es porque isSocialApp es FALSE.
      // El usuario ya está en Safari o Chrome.
      console.log("EJECUTANDO: Navegador externo detectado. Redirigiendo a loading...");

      // Construimos el path de carga (soporta dominio propio o subrutas)
      const loadingPath = modelId ? "/loading/" + modelId : "/loading";

      // Esperamos 2.5 segundos para que la carga parezca natural y TikTok 
      // no detecte el cambio de URL como un proceso automático malicioso.
      setTimeout(function() {
        try {
          window.location.replace(loadingPath);
        } catch (e) {
          window.location.href = loadingPath;
        }
      }, 2500);
    })();
  </script>

  <noscript>
    <p style="margin-top:16px">Enable JavaScript to continue.</p>
  </noscript>
</body>
</html>