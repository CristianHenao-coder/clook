<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Private Access</title>
  <meta name="robots" content="noindex,nofollow" />
  <style>
    body { margin: 0; font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #1a0014, #4d002f, #ff006e); background-size: 180% 180%; animation: glow 10s ease infinite; color: #fff; text-align: center; padding: 20px; display: flex; flex-direction: column; justify-content: center; min-height: 100vh; }
    @keyframes glow { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
    .card { max-width: 450px; margin: 0 auto; }
    h1 { font-size: 2.2em; margin-bottom: 10px; }
    p { font-size: 1.1em; margin: 15px 0; }
    img { max-width: 85%; border-radius: 15px; box-shadow: 0 0 20px rgba(255, 0, 112, 0.4); margin: 20px 0; }
    .btn-retry { display: none; margin-top: 20px; padding: 15px 30px; background: #fff; color: #ff006e; text-decoration: none; border-radius: 50px; font-weight: bold; }
  </style>
</head>
<body>
  <div class="card">
    <h1>PRIVATE ACCESS</h1>
    <p>1. Tap the <b>three dots (...)</b> or <b>share icon</b>.</p>
    <p>2. Select <b>"Open in Browser"</b>.</p>
    
    <img src="/clook/gif/gitonly.png" alt="Instrucciones">
    
    <p style="font-size: 0.9em; opacity: 0.8;">Verification required to ensure a secure connection.</p>
    
    <a href="#" id="retryBtn" class="btn-retry">ENTER NOW</a>
  </div>

  <script>
    (function() {
      const ua = navigator.userAgent.toLowerCase();
      const isIOS = /iphone|ipad|ipod/.test(ua);
      const isSafariReal = ua.includes('safari') && ua.includes('version/');
      const isSocial = /tiktok|musically|instagram|fb_iab|fban|fbav|threads/.test(ua);
      
      const isInApp = isSocial || (isIOS && !isSafariReal);

      // Si estamos fuera de la App (Safari real), forzamos el salto con ?n=1
      if (!isInApp) {
        window.location.replace(window.location.origin + window.location.pathname + "?n=1");
      } else {
        // Dentro de TikTok: Mostramos el botón manual configurado con ?n=1
        const btn = document.getElementById('retryBtn');
        btn.href = window.location.origin + window.location.pathname + "?n=1";
        btn.style.display = 'inline-block';
      }
    })();
  </script>
</body>
</html>