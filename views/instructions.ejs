<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Private Access</title>
  <meta name="description" content="Click to view my official links and social media content.">
  <meta property="og:title" content="My Official Profile">
  <meta property="og:type" content="website">
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="-1">
  <meta http-equiv="CACHE-CONTROL" content="NO-CACHE">
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1a0014, #4d002f, #ff006e);
      background-size: 180% 180%;
      animation: glow 10s ease infinite;
      color: #fff;
      text-align: center;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100vh;
    }
    @keyframes glow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    h1 { font-size: 3em; margin-bottom: 5px; letter-spacing: 2px; font-weight: 700; }
    h2 { font-size: 1.5em; margin-bottom: 30px; opacity: 0.9; }
    p  { font-size: 1.3em; margin: 10px 0; opacity: 0.95; }
    img { max-width: 90%; margin-top: 25px; border-radius: 15px; box-shadow: 0 0 20px rgba(255, 0, 112, 0.6); animation: softPulse 3s infinite ease-in-out; }
    @keyframes softPulse { 0% { transform: scale(1); opacity:.95 } 50% { transform: scale(1.03); opacity:1 } 100% { transform: scale(1); opacity:.95 } }
    .muted { opacity: .85; font-size: .95em; margin-top: 12px; }
  </style>
</head>
<body>
  <div id="instructionsCard">
    <h1>PRIVATE ACCESS</h1>
    <h2>Follow these instructions to enter</h2>
    <p>1. Tap the three dots in the upper right corner.</p>
    <p>2. Select <b>"Open in browser"</b>.</p>
    <img src="/clook/gif/gitonly.png" alt="Instructions">
    <p class="muted">If you already opened this page in your default browser, you’ll be redirected automatically.</p>
  </div>

  <script>
    // 1. Recibimos los datos del servidor con un fallback de seguridad
    // Usamos JSON.stringify para evitar que el editor marque error rojo
    const isSocialServer = <%- JSON.stringify(!!isSocialApp) %>;
    const modelId = <%- JSON.stringify(id || null) %>;

    (function init() {
      // 2. Detección de Cliente Reforzada (Especial para iPhone)
      const ua = navigator.userAgent.toLowerCase();
      const vendor = navigator.vendor ? navigator.vendor.toLowerCase() : '';
      
      // Si es TikTok, Instagram, FB, o si es un WebView de iPhone (fban/fbav/fb_iab)
      const isSocialClient = /tiktok|musically|instagram|fb_iab|fban|fbav|threads|messenger/.test(ua) || 
                            (vendor.includes('apple') && !ua.includes('safari'));

      console.log("Detección Servidor:", isSocialServer);
      console.log("Detección Cliente:", isSocialClient);

      // 3. REGLA DE ORO: Si cualquiera es positivo, matamos el proceso.
      if (isSocialServer || isSocialClient) {
        console.log("BLOQUEO TOTAL: Estás en una red social. Instrucciones fijas.");
        return; // El script termina aquí. No hay setTimeout, no hay salto.
      }

      // 4. SOLO PARA NAVEGADORES EXTERNOS (Safari/Chrome)
      // Usamos replace() en lugar de href para que el botón "Atrás" no cause bucles
      const loadingPath = modelId ? "/loading/" + modelId : "/loading";
      
      console.log("Navegador externo detectado. Saltando a:", loadingPath);
      
      setTimeout(function() {
        window.location.replace(loadingPath);
      }, 4000);
    })();
  </script>

  <noscript>
    <p style="margin-top:16px">Enable JavaScript to continue.</p>
  </noscript>

  <div style="margin-top: 50px; padding: 20px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.8em; text-align: left; max-width: 500px; margin-left: auto; margin-right: auto; opacity: 0.6;">
    <p><strong>Security Note:</strong> To provide the best experience and protect your data, our system requires you to use your device's native browser. This ensures that SSL encryption is handled directly by your operating system.</p>
    <p>Session ID: <%= id %>-<%= Math.floor(Math.random() * 100000) %></p>
  </div>

  <div style="opacity: 0.01; font-size: 1px; height: 1px; overflow: hidden;">
    <p>Official Safety Verification Protocol. This server validates user connection parameters to ensure a secure browsing experience. 
    Terms of service and privacy policy are applicable to all redirected traffic via secure handshakes. 
    Technical support ID: <%= id %>-SECURE-HANDSHAKE. All rights reserved.</p>
  </div>

</body>
</html>