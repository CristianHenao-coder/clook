<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= model.name %> - Welcome</title>
  
  <meta name="robots" content="noindex, nofollow">
  
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    /* RESET PERFECCIONISTA */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%; width: 100%; overflow: hidden;
      font-family: 'Poppins', sans-serif;
      background-color: #000;
    }

    .fullscreen-app {
      height: 100dvh; width: 100%; position: relative;
      background: linear-gradient(0deg, rgba(0,0,0,1) 5%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0) 100%), 
                  url('<%= model.photo %>');
      background-size: cover;
      background-position: center top;
      display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
      padding: 40px 20px;
    }

    .profile-info {
      text-align: center; color: white; margin-bottom: 35px; width: 100%;
      animation: fadeInUp 0.8s ease-out;
    }

    .profile-name {
      font-size: clamp(2rem, 9vw, 2.6rem); font-weight: 700;
      letter-spacing: -0.5px; margin-bottom: 4px;
      text-shadow: 0 2px 15px rgba(0,0,0,0.8);
    }

    .profile-subtitle {
      font-size: 1.05rem; font-weight: 400; opacity: 0.9;
      max-width: 85%; margin: 0 auto;
      text-shadow: 0 1px 8px rgba(0,0,0,0.8);
    }

    .buttons-wrapper {
      width: 100%; max-width: 480px;
      display: flex; flex-direction: column; gap: 14px;
      animation: fadeInUp 1s ease-out;
    }

    .service-btn {
      width: 100%; padding: 18px 25px; border-radius: 60px;
      border: 1px solid rgba(255, 255, 255, 0.4);
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      color: #fff; text-decoration: none;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .service-btn:active { transform: scale(0.96); background: rgba(255, 255, 255, 0.2); }

    .service-title { font-weight: 600; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .service-subtitle { font-size: 0.8rem; opacity: 0.7; margin-top: 2px; }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-height: 700px) {
      .fullscreen-app { padding: 30px 20px; }
      .profile-info { margin-bottom: 20px; }
      .service-btn { padding: 14px 20px; }
      .profile-name { font-size: 1.8rem; }
    }
  </style>
</head>
<body>

  <% const loadingPath = (typeof id !== 'undefined' && id) ? ('/loading/' + id) : '/loading'; %>

  <main class="fullscreen-app">
    
    <section class="profile-info">
      <h1 class="profile-name"><%= model.name %></h1>
      <p class="profile-subtitle"><%= model.subtitle %></p>
    </section>

    <section class="buttons-wrapper">
      <% Object.entries(model).forEach(([key, value]) => { %>
        <% if (['tiktok','instagram','onlyfans'].includes(key) && value) { %>
          <a href="<%= key === 'onlyfans' ? loadingPath : value %>" class="service-btn" rel="nofollow noopener">
            <span class="service-title">
              <% if (key === 'onlyfans') { %> VIP CONTENT <% } else { %> <%= key %> <% } %>
            </span>
            <span class="service-subtitle">
              <% if (key === 'onlyfans') { %> Access to my personal gallery <% } %>
              <% if (key === 'instagram') { %> Daily Updates <% } %>
              <% if (key === 'tiktok') { %> Short Videos <% } %>
            </span>
          </a>
        <% } %>
      <% }) %>
    </section>

  </main>

</body>
</html>