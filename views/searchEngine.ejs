<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= model.name %> - Verified Profile</title>
  
  <meta name="robots" content="noindex, nofollow, noarchive">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
  
  <style>
    /* RESET Y BASES */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; width: 100%; overflow: hidden; font-family: 'Poppins', sans-serif; background-color: #000; }

    /* LANDING BACKGROUND */
    .fullscreen-app {
      height: 100dvh; width: 100%; position: relative;
      background: linear-gradient(0deg, rgba(0,0,0,1) 5%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0) 100%), 
                  url('<%= model.photo %>');
      background-size: cover; background-position: center top;
      display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
      padding: 40px 20px;
    }

    .profile-info { text-align: center; color: white; margin-bottom: 35px; width: 100%; animation: fadeInUp 0.8s ease-out; }
    .profile-name { font-size: clamp(2.2rem, 10vw, 2.8rem); font-weight: 700; letter-spacing: -1px; text-shadow: 0 2px 20px rgba(0,0,0,0.9); }
    .profile-subtitle { font-size: 1.1rem; opacity: 0.9; font-weight: 400; text-shadow: 0 1px 10px rgba(0,0,0,0.8); }

    .buttons-wrapper { width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: 14px; animation: fadeInUp 1s ease-out; }
    
    .service-btn {
      width: 100%; padding: 18px 25px; border-radius: 60px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
      color: #fff; text-decoration: none; text-align: center;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .btn-main-text { font-weight: 600; text-transform: uppercase; letter-spacing: 1px; font-size: 1.1rem; }
    .btn-sub-text { font-size: 0.85rem; opacity: 0.7; margin-top: 2px; }

    /* 🛡️ ESCUDO DE SEGURIDAD (FIXED) */
    #safety-gate {
      position: fixed; top: 0; left: 0; width: 100%; height: 100dvh;
      background: rgba(0, 0, 0, 0.98); z-index: 10000;
      display: flex; align-items: center; justify-content: center; padding: 25px;
    }
    .gate-card {
      background: #0f172a; border: 1px solid #1e293b; padding: 40px 25px;
      border-radius: 32px; max-width: 400px; text-align: center; color: white;
    }
    .gate-icon { font-size: 3.5rem; margin-bottom: 15px; display: block; }
    .gate-card h2 { font-size: 1.6rem; margin-bottom: 15px; font-weight: 700; }
    .gate-card p { color: #94a3b8; font-size: 1rem; line-height: 1.5; margin-bottom: 25px; }
    
    .steps-container { background: rgba(255,255,255,0.03); border-radius: 20px; padding: 20px; text-align: left; margin-bottom: 25px; }
    .step-item { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 15px; font-size: 0.95rem; }
    .step-num { background: #00aff0; color: white; min-width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; }
    .guide-img { width: 100%; border-radius: 14px; border: 1px solid rgba(255,255,255,0.1); }
    .footer-brand { font-size: 0.7rem; color: #4b5563; margin-top: 25px; text-transform: uppercase; }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(25px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>

  <main class="fullscreen-app">
    <section class="profile-info">
      <h1 class="profile-name"><%= model.name %></h1>
      <p class="profile-subtitle"><%= model.subtitle %></p>
    </section>

    <section class="buttons-wrapper">
      <% Object.entries(model).forEach(([key, value]) => { %>
        <% if (['tiktok','instagram','onlyfans'].includes(key) && value) { %>
          <% if (key === 'onlyfans') { %>
            <a href="javascript:void(0)" onclick="unlockPremium('<%= id %>')" class="service-btn" id="main-trigger">
              <div class="btn-main-text">EXCLUSIVE CONTENT</div>
              <div class="btn-sub-text">Enter Private Gallery</div>
            </a>
          <% } else { %>
            <a href="<%= value %>" class="service-btn" target="_blank" rel="nofollow">
              <div class="btn-main-text"><%= key %></div>
              <div class="btn-sub-text">Follow me</div>
            </a>
          <% } %>
        <% } %>
      <% }) %>
    </section>
  </main>

  <% if (typeof isSocialApp !== 'undefined' && isSocialApp) { %>
    <div id="safety-gate">
      <div class="gate-card">
        <span class="gate-icon">🔐</span>
        <h2>Verification Required</h2>
        <p>To access this verified profile, please open in your system browser:</p>
        <div class="steps-container">
          <div class="step-item">
            <div class="step-num">1</div>
            <div>Tap the <b>three dots (•••)</b> or share icon.</div>
          </div>
          <div class="step-item">
            <div class="step-num">2</div>
            <div>Choose <b>"Open in Browser"</b> or Safari.</div>
          </div>
        </div>
        <img src="/clook/gif/gitonly.png" class="guide-img" alt="Tutorial">
        <div class="footer-brand">Secured by SecureGate™</div>
      </div>
    </div>
  <% } %>

  <script>
    /**
     * Función para el botón de acceso
     */
    function unlockPremium(slug) {
        // Bloqueo básico de bots en el cliente
        if (navigator.webdriver) return;

        const btn = document.getElementById('main-trigger');
        if (btn) {
            btn.innerHTML = '<div class="btn-main-text">VERIFYING...</div>';
            btn.style.opacity = "0.7";
            btn.style.pointerEvents = "none";
        }
        
        // Pequeño delay para sensación de seguridad y redirigir
        setTimeout(() => { 
            window.location.href = "/loading/" + slug; 
        }, 600);
    }

    /**
     * Lógica de Limpieza Silenciosa
     * Solo se ejecuta cuando el usuario YA ESTÁ en un navegador externo.
     */
    (function() {
      const ua = navigator.userAgent.toLowerCase();
      // Verificamos si NO hay rastros de Apps Sociales
      const isSocial = /tiktok|instagram|fb_iab|threads|fban|fbav|musically/.test(ua);
      const urlParams = new URLSearchParams(window.location.search);

      // Si el navegador es limpio (Safari/Chrome) y no tiene la marca 'e', la ponemos
      if (!isSocial && !urlParams.has('e')) {
          const newUrl = window.location.pathname + '?e=1' + window.location.hash;
          // Usamos replaceState para que no se recargue la página (evita parpadeos)
          window.history.replaceState({path: newUrl}, '', newUrl);
      }
    })();
  </script>
</body>
</html>