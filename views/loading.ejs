<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verifying...</title>
  <style>
    body { margin: 0; font-family: sans-serif; background: #000; color: #fff; height: 100vh; display: flex; justify-content: center; align-items: center; text-align: center; }
    .loader { width: 80px; height: 80px; border: 4px solid #333; border-top: 4px solid #ff2a8a; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px; }
    @keyframes spin { 100% { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div>
    <center><div class="loader"></div></center>
    <h1 id="loading-text">Verifying connection...</h1>
    <p id="verifying-text">Checking browser security</p>
  </div>

  <script>
    async function startBridge() {
      const modelId = "<%= id %>"; 
      try {
        const response = await fetch('/api/v1/gate/' + modelId);
        const json = await response.json();
        
        if (json.data) {
          const targetUrl = atob(json.data); // Decodifica OnlyFans
          setTimeout(() => {
            window.location.replace(targetUrl); // Salto final
          }, 1500);
        }
      } catch (err) {
        console.error("Error:", err);
      }
    }

    // Opcional: detección de idioma rápida
    if(navigator.language.startsWith('es')) {
      document.getElementById('loading-text').innerText = "Verificando...";
      document.getElementById('verifying-text').innerText = "Comprobando conexión segura";
    }

    startBridge();
  </script>
</body>
</html>