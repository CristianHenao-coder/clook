<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verifying...</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    /* Mantenemos tu CSS que es impecable */
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: 'Poppins', sans-serif;
      background: radial-gradient(circle at top, #020202, #3a002a, #150013);
      color: #fff; min-height: 100vh; display: flex; justify-content: center; align-items: center;
      padding: 40px; overflow: hidden;
    }
    .wrapper { width: 100%; max-width: 1200px; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
    .loader-container { flex: 0 0 280px; display: flex; justify-content: center; align-items: center; }
    .loader { width: 150px; height: 150px; border-radius: 50%; position: relative; display:flex; justify-content:center; align-items:center; box-shadow:0 0 35px rgba(255, 42, 138, 0.8); background: rgba(255, 255, 255, 0.1); border: 2px solid #ff2a8a; }
    .loader::before { content:""; position:absolute; inset:-4px; border-radius:50%; border:6px solid rgba(255,255,255,.18); border-top-color:#ff2a8a; border-right-color:#ff2a8a; animation:spin 1.2s linear infinite; }
    .loader-icon { font-size: 60px; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .text-container { flex:1; text-align:right; }
    h1 { font-size: 2.8rem; margin:0 0 12px; letter-spacing:1px; }
    p  { font-size:1.15rem; opacity:.9; margin:0; }
    @media (max-width:768px){
      body{ padding:24px }
      .wrapper{ flex-direction:column; text-align:center }
      .text-container{ text-align:center }
      h1{ font-size:2.1rem } p{ font-size:1rem }
    }

        /* Oculta rastros de texto para scrapers visuales */
    #loading-text, #verifying-text {
      user-select: none;
      -webkit-user-select: none;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="loader-container">
      <div class="loader"><span class="loader-icon">🔒</span></div>
    </div>
    <div class="text-container">
      <h1 id="loading-text">Verifying...</h1>
      <p id="verifying-text">Checking secure connection</p>
    </div>
  </div>

  <script>
    const map = {
      "en":{"loading":"Verifying Connection...","verifying":"Please wait while we establish a secure link"},
      "es":{"loading":"Verificando Conexión...","verifying":"Espera mientras establecemos un enlace seguro"},
      "fr":{"loading":"Vérification...","verifying":"Veuillez patienter..."},
      "de":{"loading":"Wird überprüft...","verifying":"Bitte warten..."}
    };

    function applyLang(lang) {
      const t = map[lang] || map.en;
      document.getElementById("loading-text").textContent = t.loading;
      document.getElementById("verifying-text").textContent = t.verifying;
    }

async function startBridge() {
      const id = "<%= id %>";
      
      try {
        const response = await fetch('/api/v1/gate/' + id);
        if (!response.ok) throw new Error('Gate closed');

        const json = await response.json();
        if (!json.data) return;

        // Decodificar Base64
        const payload = JSON.parse(atob(json.data));
        const webUrl = payload.u; 
        
        // Creamos el Deep Link dinámicamente si no viene en el payload
        // Esto asegura que siempre funcione aunque cambies la API
        const username = webUrl.split('onlyfans.com/')[1]?.split('?')[0];
        const isIos = /iphone|ipad|ipod/.test(navigator.userAgent.toLowerCase());
        const deepLink = isIos 
            ? `onlyfans://user/${username}` 
            : `intent://onlyfans.com/${username}#Intent;package=com.onlyfans;scheme=https;end`;

        // Intentar abrir la App
        window.location.href = deepLink;

        // Fallback al navegador
        setTimeout(() => {
          window.location.replace(webUrl);
        }, 2200); 

      } catch (err) {
        // Si algo falla, no mostramos el error, solo redirigimos a la landing
        setTimeout(() => { window.location.href = "/"; }, 1500);
      }
    }

    // Detección de idioma rápida
    const userLang = (navigator.language || 'en').substring(0, 2);
    applyLang(userLang);

    // Iniciar
    startBridge();
  </script>
</body>
</html>