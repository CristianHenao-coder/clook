<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verifying...</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="Cache-Control" content="no-store" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: 'Poppins', sans-serif;
      background: radial-gradient(circle at top, #020202, #3a002a, #150013);
      color: #fff; min-height: 100vh; display: flex; justify-content: center; align-items: center;
      padding: 40px; overflow: hidden;
    }
    .wrapper { width: 100%; max-width: 1200px; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
    .loader-container { flex: 0 0 280px; display: flex; justify-content: center; align-items: center; }
    /* Estilo del loader modificado para que no necesite logo de OnlyFans */
    .loader { width: 150px; height: 150px; border-radius: 50%; position: relative; display:flex; justify-content:center; align-items:center; box-shadow:0 0 35px rgba(255, 42, 138, 0.8); background: rgba(255, 255, 255, 0.1); border: 2px solid #ff2a8a; }
    .loader::before { content:""; position:absolute; inset:-4px; border-radius:50%; border:6px solid rgba(255,255,255,.18); border-top-color:#ff2a8a; border-right-color:#ff2a8a; animation:spin 1.2s linear infinite; }
    .loader-icon { font-size: 60px; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .text-container { flex:1; text-align:right; }
    h1 { font-size: 2.8rem; margin:0 0 12px; letter-spacing:1px; }
    p  { font-size:1.15rem; opacity:.9; margin:0; }
    @media (max-width:768px){
      body{ padding:24px }
      .wrapper{ flex-direction:column; text-align:center }
      .text-container{ text-align:center }
      h1{ font-size:2.1rem } p{ font-size:1rem }
    }
  </style>
</head>
<body>
  <div class="wrapper" id="main-content">
    <div class="loader-container">
      <div class="loader">
        <span class="loader-icon">🔒</span>
      </div>
    </div>
    <div class="text-container">
      <h1 id="loading-text">Verifying...</h1>
      <p id="verifying-text">Checking secure connection</p>
    </div>
  </div>

  <script>
    // 1. Configuraciones de Idioma (Igual que la competencia)
    const map = {
      "en":{"loading":"Checking your browser...","verifying":"Please wait while we verify you're human"},
      "es":{"loading":"Verificando el navegador...","verifying":"Por favor, espera mientras verificamos que eres humano"},
      "fr":{"loading":"Vérification du navigateur...","verifying":"Veuillez patienter..."},
      "de":{"loading":"Browser wird überprüft...","verifying":"Bitte warten..."}
    };

    function applyLang(lang) {
      const t = map[lang] || map.en;
      document.getElementById("loading-text").textContent = t.loading;
      document.getElementById("verifying-text").textContent = t.verifying;
    }

    // 2. Detección de Bot/TikTok
    function isBotOrInApp() {
      const ua = navigator.userAgent.toLowerCase();
      // Si detecta tiktok, instagram o webview, lo bloqueamos aquí
      return /bot|crawl|spider|webview|tiktok|instagram|fb_iab/.test(ua);
    }

    // 3. Lógica de Redirección Segura
    async function startBridge() {
      // 1. Obtener el ID de forma ultra-segura
      // Filtramos los trozos vacíos para que no importe si hay barras extras al final
      const pathParts = window.location.pathname.split('/').filter(part => part !== "");
      
      // El ID siempre será el último elemento si la URL es /loading/ID
      const id = pathParts[pathParts.length - 1];

      // 2. Verificación de seguridad: ¿Es un ID o es la palabra "loading"?
      if (!id || id === 'loading') {
        console.error("ID no detectado. URL actual:", window.location.pathname);
        // Opcional: Redirigir al inicio si no hay ID
        return;
      }

      // 3. Bloqueo de Bots/TikTok (Cloaking)
      if (isBotOrInApp()) {
        document.body.innerHTML = "<div style='padding:50px; text-align:center;'><h1>404 Not Found</h1><p>The requested URL was not found on this server.</p></div>";
        return;
      }

      try {
        // 4. Petición a la API
        const response = await fetch('/api/v1/gate/' + id);
        
        if (!response.ok) {
          console.error("Error en el servidor:", response.status);
          return;
        }

        const json = await response.json();
        
        if (json.data) {
          const target = atob(json.data); // Decodificamos el OnlyFans
          setTimeout(() => {
            window.location.replace(target);
          }, 3500);
        }
      } catch (err) {
        console.error("Error en la conexión segura:", err);
      }
    }

    // Ejecutar detección de idioma por IP
    fetch('https://ipapi.co/json')
      .then(res => res.json())
      .then(data => {
        const lang = (data.languages || 'en').split(',')[0].substring(0,2);
        applyLang(lang);
      }).catch(() => applyLang(navigator.language.substring(0,2)));

    // Iniciar proceso
    startBridge();
  </script>
</body>
</html>